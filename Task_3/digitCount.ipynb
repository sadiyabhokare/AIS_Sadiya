   "source": [
    "# Function to count digits in a number\n",
    "def count_digits(num):\n",
    "    count = 0\n",
    "    \n",
    "    while num > 0:\n",
    "        count += 1\n",
    "        num = num // 10\n",
    "        \n",
    "    return count\n",
    "\n",
    "digit=12345\n",
    "\n",
    "print(\"Total digits:\", count_digits(digit))\n"
   ]
