   "source": [
    "# Function to find total number of combinations\n",
    "def sum_list(numbers):\n",
    "    total = 0\n",
    "    \n",
    "    for i in numbers:\n",
    "        total = total + i\n",
    "        \n",
    "    return total\n",
    "\n",
    "\n",
    "sample_list = [8, 2, 3, 0, 7]\n",
    "print(\"Sum of list:\", sum_list(sample_list))\n"
   ]
