   "source": [
    "# Function to find the maximum from given numbers\n",
    "def max(numbers):\n",
    "    maximum=numbers[0]\n",
    "    for i in numbers:\n",
    "        if i>maximum:\n",
    "            maximum=i\n",
    "    return maximum\n",
    "numbers = [3, 5, 2, 8, 1,4,9,6,7]\n",
    "print(\"The maximum number is:\", max(numbers))"
   ]
