    "# Function to sum all numbers in a list\n",
    "def sum_list(numbers):\n",
    "    total=0\n",
    "    for i in numbers:\n",
    "        total+=i\n",
    "    return total\n",
    "numbers = [12, 25, 34, 4, 57]\n",
    "print(\"The sum is:\", sum_list(numbers))"
   ]
