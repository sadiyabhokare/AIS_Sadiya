   "source": [
    "# Function to reverse a string\n",
    "def reverse_string(text):\n",
    "    rev = \"\"\n",
    "    \n",
    "    for ch in text:\n",
    "        rev = ch + rev\n",
    "        \n",
    "    return rev\n",
    "\n",
    "text = \"hello\"\n",
    "print(\"Original string:\", text)\n",
    "\n",
    "print(\"Reversed string:\", reverse_string(text))\n"
   ]
  },
