   "source": [
    "# Function to find factorial\n",
    "def factorial(n):\n",
    "    fact = 1\n",
    "    \n",
    "    for i in range(1, n + 1):\n",
    "        fact = fact * i\n",
    "        \n",
    "    return fact\n",
    "\n",
    "n=5\n",
    "print(\"Factorial is:\", factorial(n))\n"
   ]
  },
