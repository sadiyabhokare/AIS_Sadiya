    "Renaming Columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "346e689e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "bd3e6b2e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Name  Age  Marks\n",
      "0    A   20     85\n",
      "1    B   21     90\n",
      "2    C   22     78\n",
      "3    D   23     92\n"
     ]
    }
   ],
   "source": [
    "df = pd.DataFrame({\n",
    "    'Name': ['A', 'B', 'C', 'D'],\n",
    "    'Age': [20, 21, 22, 23],\n",
    "    'Marks': [85, 90, 78, 92]\n",
    "})\n",
    "\n",
    "print(df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "febbc6ba",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Name  Age  Score\n",
      "0    A   20     85\n",
      "1    B   21     90\n",
      "2    C   22     78\n",
      "3    D   23     92\n"
     ]
    }
   ],
   "source": [
    "df_renamed = df.rename(columns={'Marks': 'Score'})\n",
    "print(df_renamed)"
   ]
  },
