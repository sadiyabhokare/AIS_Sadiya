   "source": [
    "# Creating a tuple\n",
    "t = (10, 20, 30, 20, 40)\n",
    "\n",
    "# Accessing elements\n",
    "print(t[0])\n",
    "print(t[1:4])\n",
    "\n",
    "# Concatenation\n",
    "t2 = (50, 60)\n",
    "print(t + t2)\n",
    "\n",
    "# Repetition\n",
    "print(t * 2)\n",
    "\n",
    "# Count and index\n",
    "print(\"Count of 20:\", t.count(20))\n",
    "print(\"Index of 30:\", t.index(30))\n"
   ]
  },
