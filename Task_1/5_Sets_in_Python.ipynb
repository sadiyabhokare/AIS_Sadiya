   "source": [
    "# Creating sets\n",
    "A = {1, 2, 3, 4}\n",
    "B = {3, 4, 5, 6}\n",
    "\n",
    "# Adding elements\n",
    "A.add(7)\n",
    "print(A)\n",
    "\n",
    "# Removing elements\n",
    "A.remove(2)\n",
    "print(A)\n",
    "\n",
    "# Set operations\n",
    "print(\"Union:\", A.union(B))\n",
    "print(\"Intersection:\", A.intersection(B))\n",
    "print(\"Difference:\", A.difference(B))\n"
   ]
