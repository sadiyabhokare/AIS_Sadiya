   "source": [
    "# to check if a number is even or odd\n",
    "num = int(input(\"Enter a number: \"))\n",
    "\n",
    "print(\"Number:\", num)\n",
    "\n",
    "if num % 2 == 0:\n",
    "    print(\"Even number\")\n",
    "else:\n",
    "    print(\"Odd number\")\n"
   ]
