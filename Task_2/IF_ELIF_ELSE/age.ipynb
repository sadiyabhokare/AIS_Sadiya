   "source": [
    "# to categorize age groups\n",
    "age = int(input(\"Enter age: \"))\n",
    "\n",
    "print(\"Age:\", age)\n",
    "\n",
    "if age < 13:\n",
    "    print(\"Child\")\n",
    "elif age < 20:\n",
    "    print(\"Teenager\")\n",
    "elif age < 60:\n",
    "    print(\"Adult\")\n",
    "else:\n",
    "    print(\"Senior Citizen\")\n"
   ]
