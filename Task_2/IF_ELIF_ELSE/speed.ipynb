   "source": [
    "# to check speed category\n",
    "speed = int(input(\"Enter speed: \"))\n",
    "\n",
    "print(\"Speed:\", speed)\n",
    "\n",
    "if speed > 80:\n",
    "    print(\"High speed\")\n",
    "elif speed >= 40:\n",
    "    print(\"Normal speed\")\n",
    "else:\n",
    "    print(\"Low speed\")\n"
   ]
