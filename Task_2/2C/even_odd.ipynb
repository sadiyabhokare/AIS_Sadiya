   "source": [
    "# count even and odd numbers in a list\n",
    "nums = [1, 2, 3, 4, 5, 6, 7]\n",
    "\n",
    "even_count = 0\n",
    "odd_count = 0\n",
    "\n",
    "for n in nums:\n",
    "    if n % 2 == 0:\n",
    "        even_count += 1\n",
    "    else:\n",
    "        odd_count += 1\n",
    "\n",
    "print(\"Even count:\", even_count)\n",
    "print(\"Odd count:\", odd_count)\n"
   ]
  },
