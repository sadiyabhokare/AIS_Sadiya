   "source": [
    "# Count vowels in a string\n",
    "text = input(\"Enter a string: \")\n",
    "print(\"Input string:\", text)\n",
    "vowel_count = 0\n",
    "\n",
    "for ch in text:\n",
    "    if ch.lower() in \"aeiou\":\n",
    "        vowel_count += 1\n",
    "\n",
    "print(\"Number of vowels:\", vowel_count)\n"
   ]
