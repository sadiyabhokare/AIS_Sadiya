   "source": [
    "# reverse a string\n",
    "text = input(\"Enter a word: \")\n",
    "\n",
    "reverse_text = \"\"\n",
    "\n",
    "for ch in text:\n",
    "    reverse_text = ch + reverse_text\n",
    "\n",
    "print(\"Reversed string:\", reverse_text)\n"
   ]
