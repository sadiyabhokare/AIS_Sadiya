   "source": [
    "# Swap first and last element of a list\n",
    "numbers = [10, 20, 30, 40, 50]\n",
    "\n",
    "print(\"Original list:\", numbers)\n",
    "\n",
    "first = numbers[0]\n",
    "last = numbers[-1]\n",
    "\n",
    "numbers[0] = last\n",
    "numbers[-1] = first\n",
    "\n",
    "print(\"List after swapping:\", numbers)\n"
   ]
  },
