   "source": [
    "# to check palindrome number\n",
    "num = input(\"Enter a number: \")\n",
    "print(\"Original number:\", num)\n",
    "reverse_num = \"\"\n",
    "\n",
    "for digit in num:\n",
    "    reverse_num = digit + reverse_num\n",
    "\n",
    "if num == reverse_num:\n",
    "    print(\"Palindrome number\")\n",
    "else:\n",
    "    print(\"Not a palindrome\")\n"
   ]
  }
 ],
