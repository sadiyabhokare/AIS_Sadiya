   "source": [
    "# find the largest number in a list\n",
    "numbers = [25, 78, 12, 90, 34]\n",
    "print(\"Numbers in the list:\", numbers)\n",
    "max_value = numbers[0]\n",
    "\n",
    "for n in numbers:\n",
    "    if n > max_value:\n",
    "        max_value = n\n",
    "\n",
    "print(\"Largest number is:\", max_value)\n"
   ]
