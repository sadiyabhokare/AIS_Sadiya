   "source": [
    "# Remove negative numbers from a list\n",
    "nums = [10, -2, 5, -7, 8, -1]\n",
    "\n",
    "print(\"Original list:\", nums)\n",
    "\n",
    "positive_nums = []\n",
    "\n",
    "for n in nums:\n",
    "    if n >= 0:\n",
    "        positive_nums.append(n)\n",
    "\n",
    "print(\"List after removing negatives:\", positive_nums)\n"
   ]
  },
