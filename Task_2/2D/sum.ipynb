   "source": [
    "# sum of digits of a number using while loop\n",
    "number = 123\n",
    "sum=0\n",
    "while number>=0:\n",
    "    digit=number%10\n",
    "    sum=sum+digit\n",
    "    number=number//10\n",
    "print(\"Sum of digits:\",sum)"
   ]
  }
 ],
