   "source": [
    "# Reverse a number using while loop\n",
    "number = int(input(\"Enter a number: \"))\n",
    "rev = 0\n",
    "while number>0:\n",
    "    digit=number%10\n",
    "    rev=rev*10+digit\n",
    "    number=number//10\n",
    "print(\"Reversed Number:\",rev)"
   ]
  },
