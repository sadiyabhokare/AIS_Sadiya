   ],
   "source": [
    "# multiplication table using while loop\n",
    "num = int(input(\"Enter a number: \"))\n",
    "\n",
    "i = 1\n",
    "while i <= 10:\n",
    "    print(num, \"x\", i, \"=\", num * i)\n",
    "    i = i + 1\n"
   ]
