   "source": [
    "# count digits in a number using while loop\n",
    "num = int(input(\"Enter a number: \"))\n",
    "\n",
    "count = 0\n",
    "\n",
    "while num > 0:\n",
    "    count = count + 1\n",
    "    num = num // 10\n",
    "\n",
    "print(\"Total digits:\", count)\n"
   ]
  },
