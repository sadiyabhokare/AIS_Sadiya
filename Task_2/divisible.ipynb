   "source": [
    "# To check divisibility by 2 and 3\n",
    "n = 7\n",
    "\n",
    "if n % 2 == 0 and n % 3 == 0:\n",
    "    print(\"Divisible by 2 and 3\")\n",
    "elif n % 2 == 0:\n",
    "    print(\"Divisible by 2, not 3\")\n",
    "elif n % 3 == 0:\n",
    "    print(\"Divisible by 3, not 2\")\n",
    "else:\n",
    "    print(\"Not divisible by 2 and 3\")"
   ]
  },
