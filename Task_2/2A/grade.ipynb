   "source": [
    "# To assign grades based on percentage\n",
    "p = 50\n",
    "\n",
    "if p > 75:\n",
    "    print(\"Grade O\")\n",
    "elif p > 60 and p <= 75:\n",
    "    print(\"Grade A\")\n",
    "elif p > 50 and p <= 60:\n",
    "    print(\"Grade B\")\n",
    "elif p > 35 and p <= 50:\n",
    "    print(\"Grade C\")\n",
    "else:\n",
    "    print(\"Fail\")"
   ]
  },
