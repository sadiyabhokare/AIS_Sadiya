    "# to check if a student has passed or failed based on marks\n",
    "marks = int(input(\"Enter marks: \"))\n",
    "\n",
    "print(\"Marks:\", marks)\n",
    "\n",
    "if marks >= 35:\n",
    "    print(\"Student passed\")\n",
    "else:\n",
    "    print(\"Student failed\")\n"
   ]
