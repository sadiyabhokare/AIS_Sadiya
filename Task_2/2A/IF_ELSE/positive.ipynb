   "source": [
    "# to check if a number is positive or negative\n",
    "num = int(input(\"Enter a number: \"))\n",
    "\n",
    "print(\"Entered number:\", num)\n",
    "\n",
    "if num > 0:\n",
    "    print(\"Positive number\")\n",
    "else:\n",
    "    print(\"Negative number\")"
   ]
