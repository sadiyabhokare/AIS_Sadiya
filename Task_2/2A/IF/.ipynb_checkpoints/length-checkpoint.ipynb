   "source": [
    "# To find the length of a word and check if it's more than 5 characters\n",
    "text = input(\"Enter a word: \")\n",
    "\n",
    "length = len(text)\n",
    "print(\"Length of word:\", length)\n",
    "\n",
    "if length > 5:\n",
    "    print(\"Word length is more than 5 characters\")"
   ]
