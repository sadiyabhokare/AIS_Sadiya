   "source": [
    "# to indicate traffic signal instructions based on user input\n",
    "signal = input(\"Enter signal color: \")\n",
    "\n",
    "if signal == \"red\":\n",
    "    print(\"Stop\")\n",
    "elif signal == \"yellow\":\n",
    "    print(\"Get Ready\")\n",
    "elif signal == \"green\":\n",
    "    print(\"Go\")\n",
    "else:\n",
    "    print(\"Invalid signal\")\n"
   ]
  },
