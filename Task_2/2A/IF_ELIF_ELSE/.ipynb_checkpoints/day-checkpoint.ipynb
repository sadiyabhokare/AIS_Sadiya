   "source": [
    "# to check if a day is a weekend, start of the work week, or a weekday\n",
    "day = input(\"Enter day: \")\n",
    "\n",
    "if day == \"Saturday\" or day == \"Sunday\":\n",
    "    print(\"Weekend\")\n",
    "elif day == \"Monday\":\n",
    "    print(\"Start of work week\")\n",
    "else:\n",
    "    print(\"Weekday\")"
   ]
