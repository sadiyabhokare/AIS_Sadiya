   "source": [
    "# to assign grades based on marks\n",
    "marks = int(input(\"Enter marks: \"))\n",
    "\n",
    "print(\"Marks entered:\", marks)\n",
    "\n",
    "if marks >= 90:\n",
    "    print(\"Grade A+\")\n",
    "elif marks >= 75:\n",
    "    print(\"Grade A\")\n",
    "elif marks >= 60:\n",
    "    print(\"Grade B\")\n",
    "else:\n",
    "    print(\"Fail\")"
   ]
  },
