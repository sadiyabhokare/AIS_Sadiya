   ],
   "source": [
    "# to print multiplication table of a given number\n",
    "num = int(input(\"Enter a number for table: \"))\n",
    "\n",
    "print(\"Multiplication table of\", num)\n",
    "\n",
    "for i in range(1, 11):\n",
    "    result = num * i\n",
    "    print(num, \"x\", i, \"=\", result)\n"
   ]
  },
