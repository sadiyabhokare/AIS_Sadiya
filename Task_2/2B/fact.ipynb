   "source": [
    "# Factorial of a given number n\n",
    "n = int(input(\"Enter value of n: \"))\n",
    "\n",
    "fact = 1\n",
    "\n",
    "for i in range(1, n + 1):\n",
    "    fact = fact * i\n",
    "\n",
    "print(\"Factorial of\", n, \"is\", fact)"
   ]
