   "source": [
    "# create a  list of 20 to 1 value using  for loop (dont Use Reverse)\n",
    "reverse_list = []\n",
    "\n",
    "for i in range(20, 0, -1):\n",
    "    reverse_list.append(i)\n",
    "\n",
    "print(\"List from 20 to 1:\")\n",
    "print(reverse_list)\n"
   ]
