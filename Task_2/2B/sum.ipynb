   "source": [
    "# to calculate sum of n natural number\n",
    "n = int(input(\"Enter value of n: \"))\n",
    "\n",
    "total = 0\n",
    "\n",
    "for i in range(1, n + 1):\n",
    "    total = total + i\n",
    "\n",
    "print(\"Sum from 1 to\", n, \"is\", total)\n"
   ]
